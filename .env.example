# Gemini API 키 (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=여기에_API_키
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# 사용할 모델 (선택)
# TRAVEL_MODEL=gemini-3.5-flash
# TRAVEL_RESEARCH_MODEL=gemini-3.5-flash

# 사고(thinking) 수준: 리서치·검수·예산은 low로 토큰 절약, 일정 작성은 모델 기본값
# TRAVEL_LIGHT_THINKING=low
# TRAVEL_PLAN_THINKING=

# 일정 검수 후 최대 수정 횟수 (기본 1)
# TRAVEL_MAX_REVISIONS=1

# 세션 저장소: 기본은 로컬 SQLite. 'memory'면 저장 안 함. PostgreSQL 등도 가능.
# DATABASE_URL=sqlite+aiosqlite:///./data/sessions.db
# DATABASE_URL=postgresql+asyncpg://user:pass@host/db

# 동시에 실행할 챌린지 수 (LLM 호출량 제한)
# MAX_CONCURRENT_RUNS=4

# ADK LoggingPlugin으로 모든 콜백을 콘솔에 출력 (디버깅용, 출력이 많음)
# TRAVEL_VERBOSE_LOGGING=1
